# Google OAuth client IDs from Google Cloud Console.
# Android build: create an "Android" OAuth client for package com.pdfvault.app
# and register the SHA-1 of the signing key you build with.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Optional fallback for web builds (not used by the Android app when the
# Android client ID above is set).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional iOS client if you later build for iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
